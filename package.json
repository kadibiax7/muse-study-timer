{
  "name": "muse-study-timer",
  "version": "2.0.0",
  "description": "Floating study companion with Pomodoro cycles and local progress",
  "main": "main.js",
  "author": "Chikadibia",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "check": "node --check main.js && node --check preload.js && node --check app.js"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.muse.studytimer",
    "productName": "Muse Study Timer",
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "preload.js",
      "main.js",
      "jolly.png",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
{
  "name": "kadibia-study-timer",
  "version": "2.1.0",
  "description": "Kadibia floating study companion with focus cycles and progress",
  "main": "main.js",
  "author": "Chikadibia",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "check": "node --check main.js && node --check preload.js && node --check app.js"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.kadibia.studytimer",
    "productName": "Kadibia Study Timer",
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "preload.js",
      "main.js",
      "jolly.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Kadibia-Study-Timer-Setup-${version}.${ext}"
    }
  }
}